{
  "manifest_version": 3,
  "name": "Redirect Trace (Skeleton)",
  "version": "0.1.0",
  "description": "Trace main document redirects + status codes, cache headers, DNS (DoH), and platform detection.",
  "action": {
    "default_title": "Redirect Trace",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "webRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://cloudflare-dns.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
